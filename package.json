{
  "name": "@tianxie2026/agnes-image-gen",
  "version": "0.8.0",
  "private": true,
  "description": "DSH 生图插件：侧栏「画图 / 图库」双页 + 文生图 / 图生图（上传或拖拽参考图）+ 统一按钮与查看器（缩放 / 下载 / 打开文件夹）+ 多 API 来源（DPAPI 加密密钥）+ 提示词优化 + 对话工具 agnes_image_generate",
  "type": "module",
  "license": "MIT",
  "author": "TianXie2026",
  "repository": {
    "type": "git",
    "url": "https://github.com/TianXie2026/agnes-image-gen.git"
  },
  "homepage": "https://github.com/TianXie2026/agnes-image-gen#readme",
  "bugs": {
    "url": "https://github.com/TianXie2026/agnes-image-gen/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image-generation",
    "text-to-image",
    "agnes",
    "ai-image"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "api.js",
    "files.js",
    "params.js",
    "secret.js",
    "sources.js",
    "optimize.js",
    "service.js",
    "http.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/en.json",
    "locale/zh.json",
    "docs/DETAIL.md",
    "docs/screenshots",
    "LICENSE",
    "README.md",
    "tools/smoke.mjs",
    "tools/check.mjs",
    "tools/route-smoke.mjs"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
